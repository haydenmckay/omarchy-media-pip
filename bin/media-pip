#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Service.qml invokes a copy of this script staged outside the plugin
# directory (see cliPath's comment there for why), so $SCRIPT_DIR at
# runtime is generally *not* the plugin's real install directory --
# MEDIA_PIP_SOURCES_DIR carries the real one through as an env var. Falls
# back to the script's own location for local dev (./install.sh's copy
# under the live plugin dir, where SCRIPT_DIR/.. genuinely is correct) and
# for running this script straight out of a git checkout.
SOURCES_FILE="${MEDIA_PIP_SOURCES_DIR:-$SCRIPT_DIR/..}/sources.json"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/media-pip"
STATE_FILE="$STATE_DIR/state.json"
mkdir -p "$STATE_DIR"

# Personal overrides -- a self-hosted source's real LAN address, say --
# that must never end up in this repo's tracked sources.json, since that
# file ships in a public git checkout. Lives in the state dir specifically
# so it survives `omarchy plugin update`/reinstall, unlike anything placed
# inside the plugin's own (git-managed) install directory. Entries match
# by id: a local entry overrides *fields* of the shipped one with the same
# id (a field-level merge, not a full replace -- an id-only URL override
# still keeps the base entry's other fields, e.g. `selfHosted`, which
# decides whether the settings-cog edit UI even shows for that row; a
# full-replace merge was tried first and silently dropped that flag the
# moment a source was overridden once), or adds an entirely new source if
# the id doesn't exist upstream. Every other function in this file keeps
# reading $SOURCES_FILE unchanged -- this just repoints it once, up front,
# to the merged result.
LOCAL_SOURCES_FILE="$STATE_DIR/sources.local.json"
if [[ -f "$LOCAL_SOURCES_FILE" ]]; then
  MERGED_SOURCES_FILE="$STATE_DIR/.sources.merged.json"
  jq -s '
    (.[0] | map({(.id): .}) | add // {}) as $base
    | (.[1] | map({(.id): .}) | add // {}) as $local
    | ($base * $local) | to_entries | map(.value)
  ' "$SOURCES_FILE" "$LOCAL_SOURCES_FILE" >"$MERGED_SOURCES_FILE"
  SOURCES_FILE="$MERGED_SOURCES_FILE"
fi

MARGIN="${MEDIA_PIP_MARGIN:-16}"
ASPECT_W="${MEDIA_PIP_ASPECT_W:-16}"
ASPECT_H="${MEDIA_PIP_ASPECT_H:-9}"

SIZE_FRACTIONS=(0.25 0.38 0.55)
SIZE_NAMES=(small medium large)
CORNER_NAMES=(bottom-right bottom-left top-left top-right)

# reservationEnabled defaults off: reserving space claims a coarse full-edge
# strip (a wlr-layer-shell constraint, see plugin/SpacerWindow.qml), which is
# a big enough side effect on the rest of the desktop to be opt-in.
DEFAULT_STATE='{"activeSourceId":null,"pipActive":false,"reservationEnabled":false,"sizeIdx":0,"cornerIdx":0,"reservation":{"edge":"right","widthPx":0},"welcomeShown":false}'

[[ -f "$STATE_FILE" ]] || echo "$DEFAULT_STATE" >"$STATE_FILE"

usage() {
  cat <<EOF
Usage: media-pip <command>

Commands:
  toggle [source_id]  Show/hide PiP (float+pin+snap, or restore to tiled). With no source_id,
                       auto-detects: the one configured source with a window currently open
                       wins; with zero or several open, falls back to the last-active source.
                       Pass source_id explicitly to skip auto-detection (used by the bar
                       widget's picker when several sources are open at once).
  size                Cycle size preset: ${SIZE_NAMES[*]}. Enables PiP first if needed.
  corner              Cycle corner: ${CORNER_NAMES[*]}. Enables PiP first if needed.
  source              Cycle to the next configured source, switching PiP to it live if active.
  reservation <on|off|toggle>  Toggle whether tiled windows reserve space around the PiP.
  reconcile            Self-heal: turn off stale pipActive state if the tracked window
                       is gone or no longer actually floating+pinned. Never launches
                       anything. Called by the Quickshell service on every shell start.
  status               Print current state.
  sources-status       Print each configured source with whether it's already an installed
                       Omarchy web app. Used by the bar widget's "Manage sources" popup.
  webapp-install <source_id>  Install a configured source as a real Omarchy web app
                       (Menu > Install > Web App, pre-filled and non-interactive).
  set-source-url <source_id> <url>  Write a personal URL override to sources.local.json
                       for a self-hosted source (Plex, Jellyfin). Used by the bar
                       widget's settings-cog edit box; safe to run by hand too.
  welcome-seen         Mark the first-run welcome popup as shown, so it never auto-opens
                       again. Called by the bar widget itself, not meant to be run by hand.
EOF
  exit "${1:-0}"
}

osd() { omarchy osd -m "$1" >/dev/null 2>&1 || true; }

# Hyprland 0.56.2's Lua config dropped the classic `dispatch <name> <args>`
# CLI syntax entirely (confirmed: github.com/hyprwm/Hyprland/discussions/14255).
# Dispatchers are now called as `hl.dsp.*` Lua expressions; window selectors
# are passed as the `window` field's value using the same selector strings
# as before (e.g. "address:0x...").
hdsp() { hyprctl dispatch "$1" >/dev/null; }

# ---------------------------------------------------------------- state I/O

state_raw() { cat "$STATE_FILE"; }

state_get() {
  local filter="$1" default="$2" v
  v=$(jq -r "$filter // empty" "$STATE_FILE" 2>/dev/null)
  echo "${v:-$default}"
}

state_merge() {
  local patch_json="$1" tmp
  tmp=$(mktemp "$STATE_DIR/.state.XXXXXX")
  jq --argjson patch "$patch_json" '. * $patch' "$STATE_FILE" >"$tmp"
  mv "$tmp" "$STATE_FILE"
}

# ------------------------------------------------------------- source list

sources_json() { cat "$SOURCES_FILE"; }

source_by_id() { jq -c --arg id "$1" '.[] | select(.id == $id)' "$SOURCES_FILE"; }

first_source_id() { jq -r '.[0].id' "$SOURCES_FILE"; }

source_on_enable_key() { jq -r '.onEnableKey // empty' <<<"$(source_by_id "$1")"; }

# ------------------------------------------------------- webapp onboarding

# Path to the installed Omarchy web app .desktop file for this host, if one
# exists. Every Omarchy web app (Menu > Install > Web App, or
# omarchy-webapp-install) is a plain .desktop file with a line of the form
# `Exec=omarchy-launch-webapp <url>` -- there's no separate manifest to
# check. `head -1` makes an empty result (no match) exit 0, not the grep
# failure -- required so this composes safely under `set -e`.
webapp_desktop_file_for_host() {
  local host="$1"
  grep -l "^Exec=omarchy-launch-webapp .*${host}" \
    "$HOME/.local/share/applications/"*.desktop 2>/dev/null | head -1
}

# One-time nudge (per source, forever, not per session) toward setting up
# the "real" Omarchy web app for a source that doesn't have one yet -- e.g.
# a freshly-added sources.json entry for something like Netflix, versus
# Plex/YouTube which already are Omarchy web apps on a typical install.
# Purely cosmetic: media-pip's own launch (see launch_source_window) works
# identically either way, so this never blocks or delays the actual PiP
# launch, only informs. Fires from enable_pip, not launch_source_window,
# since it's about "is this source properly set up" in general, independent
# of whether this particular toggle happens to need a fresh window.
maybe_nudge_webapp_setup() {
  local source_id="$1" host="$2" url="$3" name="$4"
  [[ -z "$(webapp_desktop_file_for_host "$host")" ]] || return 0
  [[ "$(state_get ".webappNudged[\"$source_id\"]" false)" != "true" ]] || return 0

  omarchy-notification-send -a "Media PiP" \
    "Set up $name as a web app?" \
    "PiP works fine without it, but installing $name via Menu -> Install -> Web App (URL: $url) adds it to your app launcher like Plex and YouTube already are." \
    >/dev/null 2>&1 || true

  state_merge "$(jq -nc --arg id "$source_id" '{webappNudged:{($id):true}}')"
}

# Every configured source with whether it's already an installed Omarchy web
# app -- consumed by the bar widget's "Manage sources" popup so it can show
# a checkmark or an install action per source, without re-implementing the
# .desktop scan in QML.
#
# The `.desktop` directory is scanned once up front rather than once per
# source (webapp_desktop_file_for_host's own per-host scan is fine for its
# single-host call site in maybe_nudge_webapp_setup, but re-globbing and
# re-grepping every installed .desktop file for each of ~10 sources here
# would be ~10x the directory I/O for no benefit -- membership in one
# pre-fetched blob of Exec lines is just as correct).
cmd_sources_status() {
  local installed_execs
  installed_execs=$(grep -h "^Exec=omarchy-launch-webapp " "$HOME/.local/share/applications/"*.desktop 2>/dev/null || true)

  jq -c '.[] | {id, name, url, selfHosted}' "$SOURCES_FILE" | while IFS= read -r src; do
    host=$(host_from_url "$(jq -r '.url' <<<"$src")")
    installed=false
    [[ -z "$host" ]] || { grep -q "$host" <<<"$installed_execs" && installed=true; }
    jq -c --argjson installed "$installed" '. + {installed: $installed}' <<<"$src"
  done | jq -sc '.'
}

# Installs a configured source as a real Omarchy web app -- the same thing
# Menu > Install > Web App does, just pre-filled and non-interactive.
# Favicon fetch (empty icon arg triggers omarchy-webapp-install's own
# auto-fetch) can take a few seconds over the network; runs synchronously
# since this is a deliberate, single user-initiated action from the
# "Manage sources" popup, not something on any hot path.
#
# The auto-fetch tries the source's *own* URL first (nicer, matches what
# the interactive `omarchy webapp install` flow does), which hard-fails
# the entire install if that URL isn't actually reachable from here --
# exactly the case for a self-hosted source's placeholder/localhost URL
# with nothing running there yet (confirmed empirically: Plex's shipped
# `localhost:32400` default failed installation outright on a machine
# where Plex isn't running locally). Falling back to a generic icon name
# (no network fetch at all, per omarchy-webapp-install's own bundled-icon
# branch) means the web app still gets created either way -- a plain icon
# beats no web app at all. A final failure still reaches the caller (QML
# surfaces it), it's just no longer *this* failure mode.
cmd_webapp_install() {
  local source_id="$1" src name url
  src=$(source_by_id "$source_id")
  [[ -n "$src" ]] || { echo "Unknown source: $source_id" >&2; exit 1; }
  name=$(jq -r '.name' <<<"$src")
  url=$(jq -r '.url' <<<"$src")
  omarchy-webapp-install "$name" "$url" "" \
    || omarchy-webapp-install "$name" "$url" "video-x-generic"
}

# Writes/updates a personal URL override in sources.local.json -- backs
# the "Manage sources" popup's settings-cog edit box for self-hosted
# sources. Same file the README documents for hand-editing; this is just
# a UI-driven way to write it instead of requiring a text editor. Merges
# rather than overwrites: an existing override for a *different* source
# id is preserved, only $source_id's entry is replaced or added.
cmd_set_source_url() {
  local source_id="$1" url="$2" src name existing merged
  [[ -n "$source_id" && -n "$url" ]] || { echo "Usage: media-pip set-source-url <source_id> <url>" >&2; exit 1; }
  src=$(source_by_id "$source_id")
  [[ -n "$src" ]] || { echo "Unknown source: $source_id" >&2; exit 1; }
  name=$(jq -r '.name' <<<"$src")

  existing='[]'
  [[ ! -f "$LOCAL_SOURCES_FILE" ]] || existing=$(cat "$LOCAL_SOURCES_FILE")
  merged=$(jq -c --arg id "$source_id" --arg name "$name" --arg url "$url" '
    map(select(.id != $id)) + [{id: $id, name: $name, url: $url}]
  ' <<<"$existing")
  echo "$merged" >"$LOCAL_SOURCES_FILE"
}

next_source_id() {
  local current="$1"
  jq -r --arg cur "$current" '
    (map(.id) | index($cur)) as $i
    | if $i == null then .[0].id
      else .[($i + 1) % length].id
      end' "$SOURCES_FILE"
}

active_source_id() {
  local id
  id=$(state_get '.activeSourceId' "")
  if [[ -z "$id" || "$id" == "null" ]]; then id=$(first_source_id); fi
  echo "$id"
}

# Source ids whose window is currently open, regardless of whether this tool
# was the one that launched it (e.g. the user opened Plex by hand).
open_source_ids() {
  local id
  jq -r '.[].id' "$SOURCES_FILE" | while IFS= read -r id; do
    window_address_for "$id" >/dev/null 2>&1 && echo "$id"
  done
}

# --------------------------------------------------------------- geometry

monitor_json_for() { hyprctl monitors -j | jq -c ".[] | select(.id == $1)"; }

apply_geometry() {
  local addr="$1" mon_id="$2" size_idx="$3" corner_idx="$4"
  local mon mx my mw mh rl rt rr rb usable_x usable_y usable_w usable_h
  local prev_edge prev_width
  mon=$(monitor_json_for "$mon_id")
  # hyprctl reports monitor width/height in *physical* pixels while window
  # geometry is in logical pixels, so both must be divided by scale --
  # otherwise every size and position is wrong the moment the display is
  # scaled (Omarchy binds a 1x/1.6x/2x/3x cycle to SUPER CTRL+BACKSPACE).
  # Odd `transform` values mean the output is rotated 90/270, which swaps
  # the logical axes. Same formula omarchy-capture-webcam-resize uses for
  # its own overlay.
  read -r mx my mw mh < <(jq -r '
    . as $m
    | ((($m.transform // 0) % 2) == 1) as $rot
    | [ .x,
        .y,
        (((if $rot then .height else .width end) / .scale) | floor),
        (((if $rot then .width else .height end) / .scale) | floor)
      ] | @tsv' <<<"$mon")
  rl=$(jq -r '.reserved[0]' <<<"$mon"); rt=$(jq -r '.reserved[1]' <<<"$mon")
  rr=$(jq -r '.reserved[2]' <<<"$mon"); rb=$(jq -r '.reserved[3]' <<<"$mon")

  # The QML spacer's own exclusive zone (from the *previous* call) is part
  # of hyprctl's reported reserved area, so subtracting it here as if it
  # were someone else's space would shrink the usable area a little more
  # on every resize/reposition. Add our own last contribution back so
  # "usable" means "the monitor minus reservations that aren't ours".
  #
  # Only when the spacer is genuinely up, though: state still carries the
  # last computed width after PiP is switched off, and reservation is
  # opt-in, so adding it back unconditionally inflates the usable area by a
  # strip that was never reserved -- which sized the window off-screen.
  # The spacer's own condition is pipActive && reservationEnabled (plus a
  # liveness check on the QML side), so mirror that here, reading state as
  # it stands before this call updates it.
  if [[ "$(state_get '.pipActive' false)" == "true" \
     && "$(state_get '.reservationEnabled' false)" == "true" ]]; then
    prev_edge=$(state_get '.reservation.edge' "")
    prev_width=$(state_get '.reservation.widthPx' 0)
    [[ "$prev_edge" != "left" ]] || rl=$((rl - prev_width))
    [[ "$prev_edge" != "right" ]] || rr=$((rr - prev_width))
  fi

  usable_x=$((mx + rl)); usable_y=$((my + rt))
  usable_w=$((mw - rl - rr)); usable_h=$((mh - rt - rb))

  local frac="${SIZE_FRACTIONS[$size_idx]}" w h
  w=$(awk -v uw="$usable_w" -v f="$frac" 'BEGIN{printf "%d", uw*f}')
  h=$(awk -v w="$w" -v aw="$ASPECT_W" -v ah="$ASPECT_H" 'BEGIN{printf "%d", w*ah/aw}')

  local x y edge
  case "${CORNER_NAMES[$corner_idx]}" in
    bottom-right) x=$((usable_x + usable_w - w - MARGIN)); y=$((usable_y + usable_h - h - MARGIN)); edge="right" ;;
    bottom-left)  x=$((usable_x + MARGIN));                y=$((usable_y + usable_h - h - MARGIN)); edge="left" ;;
    top-left)     x=$((usable_x + MARGIN));                y=$((usable_y + MARGIN));                edge="left" ;;
    top-right)    x=$((usable_x + usable_w - w - MARGIN)); y=$((usable_y + MARGIN));                edge="right" ;;
  esac

  hdsp "hl.dsp.window.resize({x=$w, y=$h, relative=false, window='address:$addr'})"
  hdsp "hl.dsp.window.move({x=$x, y=$y, relative=false, window='address:$addr'})"

  state_merge "$(jq -nc --arg edge "$edge" --argjson w "$w" '{reservation:{edge:$edge,widthPx:$w}}')"
}

# ------------------------------------------------------------- window mgmt

# Strip scheme, then stop at the first ':' or '/' -- a port survives in the
# URL but never appears in Chromium's derived WM class, so leaving it in
# here breaks the class-contains-host match entirely.
host_from_url() { sed -E 's#^[a-z]+://##; s#[:/].*##' <<<"$1"; }

source_host() { host_from_url "$(jq -r '.url' <<<"$(source_by_id "$1")")"; }

# Chromium derives WM class from the app URL's host and ignores --class
# under Wayland/Ozone (verified empirically: reserved area never changed
# when passed), so a substring match on the host is the only reliable way
# to find "this source's" window, whether we opened it or the user did
# (e.g. via the plain SUPER+SHIFT+L Plex launcher).
window_address_for() {
  local source_id="$1" host addr
  host=$(source_host "$source_id")
  addr=$(hyprctl clients -j | jq -r --arg host "$host" '[.[] | select(.class | contains($host))][0].address // empty')
  [[ -n "$addr" ]] || return 1
  echo "$addr"
}

# omarchy-launch-webapp routes through uwsm-app (systemd scope activation),
# which measured anywhere from ~1s to 15s+ of added, highly variable launch
# latency in testing -- enough to make a fixed timeout unreliable. This
# replicates its own browser-resolution logic but execs the resolved binary
# directly, matching the ~1s launch time measured when bypassing uwsm-app.
resolve_browser_exec() {
  local browser
  browser=$(xdg-settings get default-web-browser)
  case "$browser" in
    google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
    *) browser="chromium.desktop" ;;
  esac
  sed -n 's/^Exec=\([^ ]*\).*/\1/p' {"$HOME"/.local,"$HOME"/.nix-profile,/usr}/share/applications/"$browser" 2>/dev/null | head -1
}

launch_source_window() {
  local source_id="$1" url name host candidate waited browser_exec

  url=$(jq -r '.url' <<<"$(source_by_id "$source_id")")
  name=$(jq -r '.name' <<<"$(source_by_id "$source_id")")
  [[ -n "$url" && "$url" != "null" ]] || { echo "Unknown source: $source_id" >&2; exit 1; }
  host=$(source_host "$source_id")

  browser_exec=$(resolve_browser_exec)
  [[ -n "$browser_exec" ]] || { echo "Could not resolve default browser" >&2; exit 1; }

  # Routed through a transient systemd --user scope so it's fully detached
  # from this script's own process tree.
  systemd-run --user --scope --collect -q -- "$browser_exec" --app="$url" >/dev/null 2>&1 &

  # Opening a window against an *already-running* Brave instance goes
  # through Chromium's single-instance IPC to hand off the request, which
  # measured highly variable latency in testing (under 1s up to 12s+).
  # Budget generously; this is a one-time cost per source per session.
  waited=0
  candidate=""
  while (( waited < 200 )); do
    sleep 0.2
    candidate=$(hyprctl clients -j | jq -r --arg host "$host" '
      [.[] | select(.class | contains($host))][0].address // empty')
    [[ -z "$candidate" ]] || break
    waited=$((waited + 1))
  done

  [[ -n "$candidate" ]] || { echo "Timed out waiting for $name window to open" >&2; exit 1; }
  echo "$candidate"
}

# Opening a source's window is slow enough (see launch_source_window) that
# two invocations issued close together (e.g. a doubled keypress, or a
# hotkey fired while an earlier toggle is still opening the window) can
# both fail to find it yet and each launch their own -- flock serializes
# the check-then-launch per source so the second caller waits and then
# finds what the first one opened, instead of racing a duplicate.
ensure_window() {
  local source_id="$1" lock_fd
  exec {lock_fd}>"$STATE_DIR/.lock.$source_id"
  flock "$lock_fd"
  window_address_for "$source_id" || launch_source_window "$source_id"
}

# -------------------------------------------------------------------- pip

# Some sources look better with an in-page key sent every time PiP turns on
# for them -- YouTube's own 'f' hotkey drops its header/sidebar/comments
# chrome and fills the window with just the video, which matters a lot more
# at PiP sizes than in a normal tab. Verified empirically (screenshotting
# before/after): requesting fullscreen from a floated+pinned app-mode window
# stays contained inside that window's own bounds -- Hyprland never reports
# it as a real fullscreen client -- so this can't hijack the whole monitor
# the way native fullscreen normally would.
#
# Fires on every enable, not just a cold launch: this project's actual usage
# is "already sitting on a video, then toggle PiP on," so a video is
# typically already loaded well before this ever runs. 'f' *toggles*
# fullscreen rather than forcing it on, so re-enabling PiP without the page
# having changed in between (no navigation, still mid-session) can flip it
# back off -- there's no reliable way to read the page's own fullscreen
# state from outside it, so this is a known, accepted rough edge: press 'f'
# manually to fix it if that happens.
send_on_enable_key() {
  local source_id="$1" addr="$2" name="$3" fresh_launch="$4" key
  key=$(source_on_enable_key "$source_id")
  [[ -n "$key" ]] || return 0

  # ydotoold ships with Omarchy (voxtype/dictation depends on it) but its
  # unit is disabled by default and isn't otherwise kept running -- start it
  # on demand rather than failing every time until someone happens to have
  # it up already.
  systemctl --user is-active --quiet ydotool.service \
    || systemctl --user start ydotool.service 2>/dev/null || true

  local prev_addr; prev_addr=$(hyprctl activewindow -j | jq -r '.address // empty')
  hdsp "hl.dsp.focus({window='address:$addr'})" || true
  # Only a fresh launch needs a moment for the page's JS to load and attach
  # its own keyboard shortcut listeners -- an already-open window (the
  # common case here) gets the key immediately.
  [[ -z "$fresh_launch" ]] || sleep "${MEDIA_PIP_KEY_DELAY:-2.5}"
  ydotool type -- "$key" \
    || echo "media-pip: couldn't send '$key' to $name (is ydotoold running?)" >&2
  [[ -z "$prev_addr" || "$prev_addr" == "$addr" ]] \
    || hdsp "hl.dsp.focus({window='address:$prev_addr'})" || true
}

enable_pip() {
  local source_id="$1" addr mon_id win size_idx corner_idx name url host src fresh_launch=""
  window_address_for "$source_id" >/dev/null 2>&1 || fresh_launch=1
  src=$(source_by_id "$source_id")
  name=$(jq -r '.name' <<<"$src")
  url=$(jq -r '.url' <<<"$src")
  host=$(host_from_url "$url")
  # A plain `x=$(cmd)` assignment does not reliably trip `set -e` when cmd
  # fails, so ensure_window's failure must be checked explicitly here --
  # otherwise this proceeds to dispatch Hyprland calls against an empty
  # window selector.
  addr=$(ensure_window "$source_id") || exit 1
  [[ -n "$addr" ]] || exit 1
  win=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  mon_id=$(jq -r '.monitor' <<<"$win")

  hdsp "hl.dsp.window.float({action='enable', window='address:$addr'})"
  hdsp "hl.dsp.window.pin({action='enable', window='address:$addr'})"

  size_idx=$(state_get '.sizeIdx' 0)
  corner_idx=$(state_get '.cornerIdx' 0)
  apply_geometry "$addr" "$mon_id" "$size_idx" "$corner_idx"

  send_on_enable_key "$source_id" "$addr" "$name" "$fresh_launch"
  maybe_nudge_webapp_setup "$source_id" "$host" "$url" "$name"

  state_merge "$(jq -nc --arg id "$source_id" '{activeSourceId:$id,pipActive:true}')"
  osd "PiP: $name — ${CORNER_NAMES[$corner_idx]} — ${SIZE_NAMES[$size_idx]}"
}

disable_pip() {
  local source_id addr
  source_id=$(active_source_id)
  addr=$(window_address_for "$source_id") || { state_merge '{"pipActive":false}'; return; }

  hdsp "hl.dsp.window.pin({action='disable', window='address:$addr'})"
  hdsp "hl.dsp.window.float({action='disable', window='address:$addr'})"
  state_merge '{"pipActive":false}'
  osd "PiP: off"
}

# ---------------------------------------------------------------- commands

# Which source to open when PiP is off and no explicit source was given
# (used by toggle/size/corner alike): with exactly one configured source's
# window currently open, that's an unambiguous "this is what the user
# means" even if a different source was last active. Zero or multiple open
# is ambiguous -- fall back to the stored/default source. The bar widget
# handles the multiple-open case itself by prompting instead of calling
# toggle blind; a bare hotkey press has no such UI and always falls back
# the same way.
auto_detect_source_id() {
  local open_ids; open_ids=($(open_source_ids))
  if [[ ${#open_ids[@]} -eq 1 ]]; then
    echo "${open_ids[0]}"
  else
    active_source_id
  fi
}

cmd_toggle() {
  local explicit="${1:-}"
  local active; active=$(state_get '.pipActive' false)
  if [[ "$active" == "true" ]]; then disable_pip; return; fi
  enable_pip "${explicit:-$(auto_detect_source_id)}"
}

cmd_size() {
  local active; active=$(state_get '.pipActive' false)
  if [[ "$active" != "true" ]]; then enable_pip "$(auto_detect_source_id)"; return; fi
  local source_id addr mon_id cur next
  source_id=$(active_source_id)
  addr=$(window_address_for "$source_id") || { enable_pip "$source_id"; return; }
  mon_id=$(jq -r '.monitor' <<<"$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')")
  cur=$(state_get '.sizeIdx' 0)
  next=$(((cur + 1) % ${#SIZE_NAMES[@]}))
  state_merge "$(jq -nc --argjson v "$next" '{sizeIdx:$v}')"
  apply_geometry "$addr" "$mon_id" "$next" "$(state_get '.cornerIdx' 0)"
  osd "PiP size: ${SIZE_NAMES[$next]}"
}

cmd_corner() {
  local active; active=$(state_get '.pipActive' false)
  if [[ "$active" != "true" ]]; then enable_pip "$(auto_detect_source_id)"; return; fi
  local source_id addr mon_id cur next
  source_id=$(active_source_id)
  addr=$(window_address_for "$source_id") || { enable_pip "$source_id"; return; }
  mon_id=$(jq -r '.monitor' <<<"$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')")
  cur=$(state_get '.cornerIdx' 0)
  next=$(((cur + 1) % ${#CORNER_NAMES[@]}))
  state_merge "$(jq -nc --argjson v "$next" '{cornerIdx:$v}')"
  apply_geometry "$addr" "$mon_id" "$(state_get '.sizeIdx' 0)" "$next"
  osd "PiP corner: ${CORNER_NAMES[$next]}"
}

cmd_source() {
  local current next active
  current=$(active_source_id)
  next=$(next_source_id "$current")
  active=$(state_get '.pipActive' false)
  if [[ "$active" == "true" ]]; then
    disable_pip
    enable_pip "$next"
  else
    state_merge "$(jq -nc --arg id "$next" '{activeSourceId:$id}')"
    osd "PiP source: $(jq -r '.name' <<<"$(source_by_id "$next")")"
  fi
}

cmd_reservation() {
  local mode="${1:-toggle}" cur next
  cur=$(state_get '.reservationEnabled' false)
  case "$mode" in
    on) next=true ;;
    off) next=false ;;
    toggle) [[ "$cur" == "true" ]] && next=false || next=true ;;
    *) echo "Usage: media-pip reservation <on|off|toggle>" >&2; exit 1 ;;
  esac
  state_merge "$(jq -nc --argjson v "$next" '{reservationEnabled:$v}')"
  osd "PiP reservation: $([[ $next == true ]] && echo on || echo off)"
}

# Quickshell reloads Service.qml on every shell restart (login, crash
# recovery, `omarchy restart shell`) and it just mirrors state.json as-is,
# including reservation. Persisted `pipActive:true` from a source that was
# genuinely left in PiP mode is worth restoring, but stale `pipActive:true`
# left over from a source that's since been closed (or a laptop reboot
# that dropped Hyprland's floating/pinned state entirely) would otherwise
# make the reservation spacer silently claim real screen space -- with no
# window actually floating there -- the instant the shell loads, with no
# user action at all. This is called from Service.qml on startup specifically
# to make that opt-in: never launches anything, only ever turns a stale
# "on" into an honest "off" by checking the tracked window still exists
# and is actually floating+pinned right now.
cmd_reconcile() {
  local active source_id addr win floating pinned
  active=$(state_get '.pipActive' false)
  [[ "$active" == "true" ]] || return 0

  source_id=$(active_source_id)
  addr=$(window_address_for "$source_id") || { state_merge '{"pipActive":false,"reservation":{"edge":"right","widthPx":0}}'; return 0; }

  win=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  floating=$(jq -r '.floating' <<<"$win")
  pinned=$(jq -r '.pinned' <<<"$win")
  if [[ "$floating" != "true" || "$pinned" != "true" ]]; then
    state_merge '{"pipActive":false,"reservation":{"edge":"right","widthPx":0}}'
  fi
}

cmd_status() { state_raw; }

# Marks the first-run welcome popup as shown, so plugin/BarWidget.qml never
# auto-opens it again -- see welcomeShown in DEFAULT_STATE. Called by the
# bar widget itself the moment it auto-opens the popup, not on dismissal,
# since "shown" means "displayed once," not "acted on."
cmd_welcome_seen() { state_merge '{"welcomeShown":true}'; }

main() {
  case "${1:-}" in
    toggle) cmd_toggle "${2:-}" ;;
    size) cmd_size ;;
    corner) cmd_corner ;;
    source) cmd_source ;;
    reservation) cmd_reservation "${2:-toggle}" ;;
    reconcile) cmd_reconcile ;;
    status) cmd_status ;;
    sources-status) cmd_sources_status ;;
    webapp-install) cmd_webapp_install "${2:-}" ;;
    set-source-url) cmd_set_source_url "${2:-}" "${3:-}" ;;
    welcome-seen) cmd_welcome_seen ;;
    -h | --help | "") usage 0 ;;
    *)
      echo "Unknown command: $1" >&2
      usage 1
      ;;
  esac
}

main "$@"
